+constexpr size_t kCcmOffset = 0xa8e4;
+constexpr size_t kCcmCount = 4;
+constexpr size_t kCcmWords = 6;
+constexpr int kCcmUnit = 256;
+constexpr int kCcmStrengthPercent = 60;
