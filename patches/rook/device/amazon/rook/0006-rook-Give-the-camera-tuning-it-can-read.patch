         return 1;
 
     std::unique_ptr<uint8_t[]> pline(new uint8_t[kOldPlineSize]);
     int ret = rookGetCameraDefault(type, pline.get(), kOldPlineSize);
-    if (ret == 0)
+    if (ret == 0) {
         convertPline(static_cast<uint8_t*>(data), pline.get());
+        stretchExposures(static_cast<uint8_t*>(data));
+    }
 
     return ret;
 }
 
