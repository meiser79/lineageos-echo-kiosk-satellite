rook: Inherit the Kiosk Satellite Edition layer

lineage_rook inherits the layer every Echo shares, the layer every Echo
Show shares and the rook additions, which stage-tree.sh copies into the
tree. The model gets (KS), so Home Assistant and the router show that the
Spot runs this image.

diff --git a/lineage_rook.mk b/lineage_rook.mk
index 1bc745a..f543972 100644
--- a/lineage_rook.mk
+++ b/lineage_rook.mk
@@ -12,11 +12,18 @@ $(call inherit-product, device/amazon/rook/device.mk)
 # Inherit some common LineageOS stuff.
 $(call inherit-product, vendor/lineage/config/common_full_tablet_wifionly.mk)
 
+# Inherit the Kiosk Satellite Edition layer.
+$(call inherit-product, vendor/kiosk-satellite/config/common.mk)
+$(call inherit-product, vendor/kiosk-satellite/config/show.mk)
+$(call inherit-product, device/kiosk-satellite/rook/device.mk)
+
 PRODUCT_NAME := lineage_rook
 PRODUCT_DEVICE := rook
 PRODUCT_MANUFACTURER := Amzn
 PRODUCT_BRAND := google
-PRODUCT_MODEL := Echo Spot
+# Kiosk Satellite Edition: (KS) shows in Home Assistant and on the router
+# that the Spot runs this image.
+PRODUCT_MODEL := Echo Spot (KS)
 PRODUCT_CHARACTERISTICS := tablet,nosdcard
 
 WITHOUT_SETUP_WIZARD := true
