index b9beaf1..bfa7ddb 100644
--- a/configs/vnd_rook.txt
+++ b/configs/vnd_rook.txt
@@ -5,6 +5,7 @@ RFKILL_UNBLOCK_WAIT_TIME = 150
 RFKILL_BLOCK_WAIT_TIME = 50
